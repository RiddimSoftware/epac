{
  "openapi": "3.1.0",
  "info": {
    "title": "epac Backend API",
    "version": "0.1.0",
    "description": "Public and app-facing endpoints for the epac civic data backend. All civic data originates from authoritative government sources and backend records preserve source identifiers where available."
  },
  "servers": [
    {
      "url": "https://api.epac.riddimsoftware.com",
      "description": "Production API"
    }
  ],
  "tags": [
    { "name": "Parliament", "description": "Sittings, speeches, calendar, and Hansard-derived records." },
    { "name": "Members", "description": "MP metadata, votes, and speech feeds." },
    { "name": "Bills", "description": "Bill list and status metadata." },
    { "name": "Fiscal", "description": "Government spending, estimates, and budgetary records." },
    { "name": "Telemetry", "description": "Client telemetry ingestion." },
    { "name": "Operations", "description": "Health and API documentation endpoints." }
  ],
  "paths": {
    "/openapi.json": {
      "get": {
        "tags": ["Operations"],
        "summary": "Return the OpenAPI specification",
        "operationId": "getOpenAPISpec",
        "responses": {
          "200": {
            "description": "OpenAPI document",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "/docs": {
      "get": {
        "tags": ["Operations"],
        "summary": "Render Swagger UI for the API spec",
        "description": "This endpoint is intended for authenticated internal use. Deployments should set OPENAPI_DOCS_TOKEN and require the X-Docs-Token header or token query parameter.",
        "operationId": "getDocs",
        "parameters": [
          { "$ref": "#/components/parameters/DocsTokenHeader" },
          { "$ref": "#/components/parameters/DocsTokenQuery" }
        ],
        "responses": {
          "200": {
            "description": "Swagger UI HTML",
            "content": {
              "text/html": {
                "schema": { "type": "string" },
                "examples": {
                  "html": {
                    "value": "<!doctype html><html lang=\"en\"><head><title>epac API Docs</title></head><body><div id=\"swagger-ui\"></div></body></html>"
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/sittings": {
      "get": {
        "tags": ["Parliament"],
        "summary": "List House of Commons sittings",
        "operationId": "listSittings",
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PerPage" },
          {
            "name": "from_date",
            "in": "query",
            "description": "Optional inclusive start date.",
            "schema": { "type": "string", "format": "date", "example": "2026-04-01" }
          },
          {
            "name": "to_date",
            "in": "query",
            "description": "Optional inclusive end date.",
            "schema": { "type": "string", "format": "date", "example": "2026-04-30" }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated sittings",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SittingsResponse" },
                "examples": {
                  "page": {
                    "value": {
                      "page": 1,
                      "per_page": 20,
                      "total": 1,
                      "sittings": [
                        {
                          "date": "2026-04-27",
                          "parliament_num": 45,
                          "session_num": 1,
                          "sitting_num": 1,
                          "source_url": "https://www.ourcommons.ca/documentviewer/en/45-1/house/sitting-1/hansard"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "429": { "$ref": "#/components/responses/RateLimit" }
        }
      }
    },
    "/api/v1/sittings/{date}/speeches": {
      "get": {
        "tags": ["Parliament"],
        "summary": "List speeches for a sitting date",
        "description": "Returns Hansard interventions for one sitting date. Speech ids are source-derived intervention ids.",
        "operationId": "listSittingSpeeches",
        "parameters": [
          {
            "name": "date",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "date", "example": "2026-04-27" }
          },
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PerPage" }
        ],
        "responses": {
          "200": {
            "description": "Speeches for the sitting",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SpeechesResponse" },
                "examples": {
                  "page": {
                    "value": {
                      "date": "2026-04-27",
                      "page": 1,
                      "per_page": 20,
                      "total": 1,
                      "speeches": [
                        {
                          "id": "12345678",
                          "speaker_name": "Example MP",
                          "member_id": "278707",
                          "subject_title": "The Economy",
                          "content": "Madam Speaker, ...",
                          "source_url": "https://www.ourcommons.ca/documentviewer/en/45-1/house/sitting-1/hansard"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "429": { "$ref": "#/components/responses/RateLimit" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/members": {
      "get": {
        "tags": ["Members"],
        "summary": "List members of Parliament",
        "operationId": "listMembers",
        "parameters": [
          {
            "name": "province",
            "in": "query",
            "description": "Optional province or territory filter.",
            "schema": { "type": "string", "example": "ON" }
          },
          {
            "name": "party",
            "in": "query",
            "description": "Optional party filter.",
            "schema": { "type": "string", "example": "Liberal" }
          }
        ],
        "responses": {
          "200": {
            "description": "MP list",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MembersResponse" },
                "examples": {
                  "members": {
                    "value": {
                      "members": [
                        {
                          "id": "278707",
                          "name": "Example MP",
                          "riding": "Ottawa Centre",
                          "province": "ON",
                          "party": "Liberal",
                          "source_url": "https://www.ourcommons.ca/members/en"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "429": { "$ref": "#/components/responses/RateLimit" }
        }
      }
    },
    "/api/v1/members/{id}/votes": {
      "get": {
        "tags": ["Members"],
        "summary": "List recorded votes for an MP",
        "operationId": "listMemberVotes",
        "parameters": [
          { "$ref": "#/components/parameters/MemberId" },
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PerPage" }
        ],
        "responses": {
          "200": {
            "description": "MP voting record",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MemberVotesResponse" },
                "examples": {
                  "votes": {
                    "value": {
                      "member_id": "278707",
                      "page": 1,
                      "per_page": 20,
                      "total": 1,
                      "pages": 1,
                      "votes": [
                        {
                          "vote_id": "1234",
                          "date": "2026-04-27",
                          "bill_number": "C-1",
                          "summary": "An Act respecting example data",
                          "vote": "Yea",
                          "source_url": "https://www.ourcommons.ca/members/en/votes"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "429": { "$ref": "#/components/responses/RateLimit" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/members/{id}/speeches": {
      "get": {
        "tags": ["Members"],
        "summary": "List speeches for an MP",
        "operationId": "listMemberSpeeches",
        "parameters": [
          { "$ref": "#/components/parameters/MemberId" },
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PerPage" },
          {
            "name": "topic",
            "in": "query",
            "description": "Optional case-insensitive subject title filter.",
            "schema": { "type": "string", "example": "housing" }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated speech feed and aggregate stats",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MemberSpeechesResponse" },
                "examples": {
                  "speeches": {
                    "value": {
                      "member_id": "278707",
                      "page": 1,
                      "per_page": 20,
                      "total": 1,
                      "pages": 1,
                      "stats": { "total_speeches": 42, "avg_word_count": 118, "top_topic": "Housing" },
                      "speeches": [
                        {
                          "id": "12345678",
                          "sitting_date": "2026-04-27",
                          "subject_title": "Housing",
                          "preview": "Madam Speaker, ...",
                          "filename": "HAN001-E.XML"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "429": { "$ref": "#/components/responses/RateLimit" },
          "400": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/ridings/{slug}/boundary": {
      "get": {
        "tags": ["Members"],
        "summary": "Return a federal riding boundary polygon",
        "description": "Returns simplified GeoJSON for a 2023 Representation Order federal electoral district from the published riding boundary artifact.",
        "operationId": "getRidingBoundary",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "description": "URL slug for the riding name.",
            "schema": { "type": "string", "example": "spadina-harbourfront" }
          }
        ],
        "responses": {
          "200": {
            "description": "Simplified riding boundary",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RidingBoundary" },
                "examples": {
                  "boundary": {
                    "value": {
                      "slug": "spadina-harbourfront",
                      "name": "Spadina-Harbourfront",
                      "external_id": "35100",
                      "representation_order": "2023",
                      "source": "Elections Canada - Federal Electoral District Boundary Files",
                      "source_url": "https://www.elections.ca/content.aspx?dir=cir%2FmapsCorner%2Fvector&document=index&lang=e&section=res",
                      "source_note": "Boundary geometry is resolved through Open North Represent's 2023 federal electoral district set, which mirrors the official Elections Canada 45th general election vector boundary files.",
                      "extent": [-79.41, 43.62, -79.36, 43.66],
                      "centroid": [-79.39, 43.64],
                      "geometry": {
                        "type": "MultiPolygon",
                        "coordinates": [[[[-79.41, 43.62], [-79.40, 43.63], [-79.36, 43.66], [-79.41, 43.62]]]]
                      }
                    }
                  }
                }
              }
            }
          },
          "429": { "$ref": "#/components/responses/RateLimit" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/bills": {
      "get": {
        "tags": ["Bills"],
        "summary": "List bills",
        "operationId": "listBills",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "description": "Optional status filter.",
            "schema": { "type": "string", "example": "in_progress" }
          },
          {
            "name": "parliament",
            "in": "query",
            "description": "Optional Parliament number.",
            "schema": { "type": "integer", "example": 45 }
          }
        ],
        "responses": {
          "200": {
            "description": "Bill list",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BillsResponse" },
                "examples": {
                  "bills": {
                    "value": {
                      "bills": [
                        {
                          "id": "C-1-45-1",
                          "number": "C-1",
                          "title": "An Act respecting example data",
                          "current_stage": "Second Reading",
                          "introduced_on": "2026-04-27",
                          "source_url": "https://www.parl.ca/legisinfo"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "429": { "$ref": "#/components/responses/RateLimit" }
        }
      }
    },
    "/api/v1/calendar/house.ics": {
      "get": {
        "tags": ["Parliament"],
        "summary": "Return subscribable House sitting calendar",
        "description": "Returns an RFC 5545 iCalendar feed containing House of Commons sitting days from the published calendar artifact.",
        "operationId": "getHouseSittingCalendarICS",
        "responses": {
          "200": {
            "description": "House sitting iCalendar feed",
            "content": {
              "text/calendar": {
                "schema": { "type": "string" },
                "examples": {
                  "calendar": {
                    "value": "BEGIN:VCALENDAR\r\nVERSION:2.0\r\nPRODID:-//Riddim Software//epac Parliament Calendar//EN\r\nBEGIN:VEVENT\r\nUID:house-sitting-2026-04-29@epac.riddimsoftware.com\r\nDTSTART;VALUE=DATE:20260429\r\nDTEND;VALUE=DATE:20260430\r\nSUMMARY:House of Commons — Sitting Day\r\nURL:https://epac.riddimsoftware.com/sitting/2026-04-29\r\nEND:VEVENT\r\nEND:VCALENDAR\r\n"
                  }
                }
              }
            }
          },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/config": {
      "get": {
        "tags": ["Operations"],
        "summary": "Return app configuration and feature flags",
        "operationId": "getConfig",
        "responses": {
          "200": {
            "description": "App config",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AppConfig" },
                "examples": {
                  "config": {
                    "value": {
                      "minimum_supported_version": "1.0.0",
                      "features": {
                        "search": false,
                        "topic_notifications": false
                      }
                    }
                  }
                }
              }
            }
          },
          "429": { "$ref": "#/components/responses/RateLimit" }
        }
      }
    },
    "/api/v1/on-this-day": {
      "get": {
        "tags": ["Parliament"],
        "summary": "List prior-year Parliament moments from the same calendar day",
        "description": "Returns ranked Hansard speech records from earlier years on the same month and day from the published on-this-day artifact. Ranking is computed when the artifact is published.",
        "operationId": "listOnThisDay",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": true,
            "description": "Reference date in Ottawa-local calendar form.",
            "schema": { "type": "string", "format": "date", "example": "2026-04-29" }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum items to return. Defaults to 5 and caps at 20.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 20, "default": 5 }
          }
        ],
        "responses": {
          "200": {
            "description": "Prior-year Parliament moments",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OnThisDayResponse" },
                "examples": {
                  "moments": {
                    "value": {
                      "date": "2026-04-29",
                      "items": [
                        {
                          "id": "speech:12345678",
                          "kind": "speech",
                          "year": 2021,
                          "date": "2021-04-29",
                          "title": "Housing",
                          "excerpt": "Madam Speaker, housing affordability matters...",
                          "speaker_name": "Jane Example",
                          "member_id": "278707",
                          "subject_title": "Housing",
                          "intervention_id": "12345678",
                          "source_url": "https://www.ourcommons.ca/documentviewer/en/44-1/house/sitting-1/hansard"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/RateLimit" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/hansard/search": {
      "get": {
        "tags": ["Parliament"],
        "summary": "Search Hansard interventions",
        "description": "Queries the published Hansard SQLite FTS5 index and returns paginated message hits with inline match snippets.",
        "operationId": "searchHansard",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Full-text search query. Trimmed input must be non-empty and at most 200 characters.",
            "schema": { "type": "string", "maxLength": 200, "example": "climate housing" }
          },
          {
            "name": "speaker",
            "in": "query",
            "required": false,
            "description": "Optional case-insensitive speaker-name filter.",
            "schema": { "type": "string", "maxLength": 100, "example": "Jane Smith" }
          },
          {
            "name": "topic",
            "in": "query",
            "required": false,
            "description": "Optional case-insensitive intervention topic filter.",
            "schema": { "type": "string", "maxLength": 200, "example": "Budget Implementation Act" }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "One-based page number.",
            "schema": { "type": "integer", "minimum": 1, "default": 1 }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "description": "Items per page.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated Hansard search results",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HansardSearchResponse" },
                "examples": {
                  "results": {
                    "value": {
                      "page": 1,
                      "per_page": 20,
                      "total": 42,
                      "results": [
                        {
                          "parliament_number": 45,
                          "session_number": 1,
                          "sitting_date": "2026-04-27",
                          "intervention_id": "12345",
                          "message_id": "12345-p3",
                          "speaker_name": "Smith",
                          "party_abbreviation": "LIB",
                          "riding_name": "Some Riding",
                          "topic": "Budget Implementation Act",
                          "snippet": "...matched <mark>phrase</mark>...",
                          "score": 1.23
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/RateLimit" },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/estimates": {
      "get": {
        "tags": ["Fiscal"],
        "summary": "List Main Estimates by fiscal year",
        "operationId": "listEstimates",
        "parameters": [
          {
            "name": "fiscal_year",
            "in": "query",
            "required": true,
            "description": "Fiscal year in YYYY-YY format (e.g., 2024-25).",
            "schema": { "type": "string", "example": "2024-25" }
          }
        ],
        "responses": {
          "200": {
            "description": "Estimates for the fiscal year",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EstimatesResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/RateLimit" }
        }
      }
    },
    "/api/v1/estimates/{org_id}": {
      "get": {
        "tags": ["Fiscal"],
        "summary": "Get estimates for a specific organization",
        "operationId": "getOrganizationEstimates",
        "parameters": [
          {
            "name": "org_id",
            "in": "path",
            "required": true,
            "description": "Canonical organization ID from GC InfoBase.",
            "schema": { "type": "integer", "example": 1 }
          },
          {
            "name": "fiscal_year",
            "in": "query",
            "description": "Optional fiscal year filter.",
            "schema": { "type": "string", "example": "2024-25" }
          }
        ],
        "responses": {
          "200": {
            "description": "Estimates for the organization",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EstimatesResponse" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/RateLimit" }
        }
      }
    },
    "/api/v1/telemetry": {
      "post": {
        "tags": ["Telemetry"],
        "summary": "Ingest batched client telemetry events",
        "description": "Accepts a batch of telemetry events from iOS clients and emits CloudWatch EMF lines. No PII should be included in message or attributes fields.",
        "operationId": "postTelemetry",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TelemetryRequest" },
              "examples": {
                "batch": {
                  "value": {
                    "device_id": "A1B2C3D4-E5F6-7890-ABCD-EF1234567890",
                    "app_version": "1.2.0",
                    "os_version": "18.1",
                    "events": [
                      {
                        "type": "event",
                        "name": "app_launch",
                        "ts": "2026-05-26T12:00:00Z"
                      },
                      {
                        "type": "span",
                        "name": "api_call",
                        "operation": "GET /api/v1/sittings",
                        "duration_ms": 150,
                        "ts": "2026-05-26T12:00:01Z"
                      },
                      {
                        "type": "error",
                        "name": "network_failure",
                        "message": "connection timeout",
                        "ts": "2026-05-26T12:00:02Z"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Events accepted"
          },
          "400": { "$ref": "#/components/responses/Error" },
          "405": { "$ref": "#/components/responses/Error" },
          "415": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/RateLimit" }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["Operations"],
        "summary": "Return pipeline health",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "All pipelines healthy",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" },
                "examples": {
                  "ok": {
                    "value": {
                      "status": "ok",
                      "checked_at": "2026-04-28T14:00:00Z",
                      "pipelines": [
                        {
                          "name": "daily-fetch",
                          "last_run_at": "2026-04-28T12:00:00Z",
                          "last_success_at": "2026-04-28T12:00:00Z",
                          "record_count": 42,
                          "expected_interval_hours": 24,
                          "healthy": true
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "One or more pipelines are stale or health storage is unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    { "$ref": "#/components/schemas/HealthResponse" },
                    { "$ref": "#/components/schemas/ErrorResponse" }
                  ]
                },
                "examples": {
                  "degraded": {
                    "value": {
                      "status": "degraded",
                      "checked_at": "2026-04-28T14:00:00Z",
                      "pipelines": [
                        {
                          "name": "daily-fetch",
                          "last_run_at": "2026-04-25T12:00:00Z",
                          "last_success_at": "2026-04-25T12:00:00Z",
                          "last_error": "source returned 503",
                          "record_count": 0,
                          "expected_interval_hours": 24,
                          "healthy": false,
                          "stale_for": "72h0m0s"
                        }
                      ]
                    }
                  },
                  "storageUnavailable": {
                    "value": {
                      "error": "db connect: DATABASE_URL not set"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "Page": {
        "name": "page",
        "in": "query",
        "description": "One-based page number.",
        "schema": { "type": "integer", "minimum": 1, "default": 1 }
      },
      "PerPage": {
        "name": "per_page",
        "in": "query",
        "description": "Items per page.",
        "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
      },
      "MemberId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Hansard Affiliation DbId for an MP.",
        "schema": { "type": "string", "example": "278707" }
      },
      "DocsTokenHeader": {
        "name": "X-Docs-Token",
        "in": "header",
        "required": false,
        "schema": { "type": "string" }
      },
      "DocsTokenQuery": {
        "name": "token",
        "in": "query",
        "required": false,
        "schema": { "type": "string" }
      }
    },
    "responses": {
      "Error": {
        "description": "Error response",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "examples": { "error": { "value": { "error": "missing member id" } } }
          }
        }
      },
      "RateLimit": {
        "description": "Rate limit exceeded. Retry after the number of seconds in the `Retry-After` header.",
        "headers": {
          "Retry-After": {
            "description": "Seconds to wait before retrying.",
            "schema": { "type": "integer", "minimum": 1 }
          },
          "X-RateLimit-Limit": {
            "description": "Maximum requests allowed in the current endpoint window.",
            "schema": { "type": "integer" }
          }
        },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/RateLimitResponse" },
            "examples": {
              "limited": {
                "value": {
                  "error": "rate limit exceeded",
                  "limit": 2,
                  "window_seconds": 60,
                  "scope": "api"
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": { "error": { "type": "string" } }
      },
      "RateLimitResponse": {
        "type": "object",
        "required": ["error", "limit", "window_seconds", "scope"],
        "properties": {
          "error": { "type": "string", "example": "rate limit exceeded" },
          "limit": { "type": "integer", "example": 2 },
          "window_seconds": { "type": "integer", "example": 60 },
          "scope": { "type": "string", "example": "api" }
        }
      },
      "StatusResponse": {
        "type": "object",
        "required": ["status"],
        "properties": { "status": { "type": "string", "example": "ok" } }
      },
      "SittingsResponse": {
        "type": "object",
        "required": ["page", "per_page", "total", "sittings"],
        "properties": {
          "page": { "type": "integer" },
          "per_page": { "type": "integer" },
          "total": { "type": "integer" },
          "sittings": { "type": "array", "items": { "$ref": "#/components/schemas/Sitting" } }
        }
      },
      "Sitting": {
        "type": "object",
        "required": ["date", "source_url"],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "parliament_num": { "type": "integer" },
          "session_num": { "type": "integer" },
          "sitting_num": { "type": "integer" },
          "source_url": { "type": "string", "format": "uri" }
        }
      },
      "SpeechesResponse": {
        "type": "object",
        "required": ["date", "page", "per_page", "total", "speeches"],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "page": { "type": "integer" },
          "per_page": { "type": "integer" },
          "total": { "type": "integer" },
          "speeches": { "type": "array", "items": { "$ref": "#/components/schemas/Speech" } }
        }
      },
      "Speech": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "description": "Source-derived Hansard intervention id." },
          "speaker_name": { "type": "string" },
          "member_id": { "type": "string" },
          "subject_title": { "type": "string" },
          "content": { "type": "string" },
          "source_url": { "type": "string", "format": "uri" }
        }
      },
      "MembersResponse": {
        "type": "object",
        "required": ["members"],
        "properties": {
          "members": { "type": "array", "items": { "$ref": "#/components/schemas/Member" } }
        }
      },
      "Member": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "riding": { "type": "string" },
          "province": { "type": "string" },
          "party": { "type": "string" },
          "source_url": { "type": "string", "format": "uri" }
        }
      },
      "MemberVotesResponse": {
        "type": "object",
        "required": ["member_id", "page", "per_page", "total", "pages", "votes"],
        "properties": {
          "member_id": { "type": "string" },
          "page": { "type": "integer" },
          "per_page": { "type": "integer" },
          "total": { "type": "integer" },
          "pages": { "type": "integer" },
          "votes": { "type": "array", "items": { "$ref": "#/components/schemas/Vote" } }
        }
      },
      "Vote": {
        "type": "object",
        "required": ["vote_id", "date", "vote"],
        "properties": {
          "vote_id": { "type": "string" },
          "date": { "type": "string", "format": "date" },
          "bill_number": { "type": "string" },
          "summary": { "type": "string" },
          "vote": { "type": "string", "enum": ["Yea", "Nay", "Paired", "Absent"] },
          "source_url": { "type": "string", "format": "uri" }
        }
      },
      "MemberSpeechesResponse": {
        "type": "object",
        "required": ["member_id", "page", "per_page", "total", "pages", "stats", "speeches"],
        "properties": {
          "member_id": { "type": "string" },
          "page": { "type": "integer" },
          "per_page": { "type": "integer" },
          "total": { "type": "integer" },
          "pages": { "type": "integer" },
          "stats": { "$ref": "#/components/schemas/MemberStats" },
          "speeches": { "type": "array", "items": { "$ref": "#/components/schemas/MemberSpeech" } }
        }
      },
      "MemberStats": {
        "type": "object",
        "required": ["total_speeches", "avg_word_count", "top_topic"],
        "properties": {
          "total_speeches": { "type": "integer" },
          "avg_word_count": { "type": "integer" },
          "top_topic": { "type": "string" }
        }
      },
      "MemberSpeech": {
        "type": "object",
        "required": ["id", "preview", "filename"],
        "properties": {
          "id": { "type": "string" },
          "sitting_date": { "type": "string", "format": "date" },
          "parliament_num": { "type": "integer" },
          "session_num": { "type": "integer" },
          "subject_title": { "type": "string" },
          "preview": { "type": "string" },
          "word_count": { "type": "integer" },
          "filename": { "type": "string" }
        }
      },
      "HansardSearchResponse": {
        "type": "object",
        "required": ["page", "per_page", "total", "results"],
        "properties": {
          "page": { "type": "integer" },
          "per_page": { "type": "integer" },
          "total": { "type": "integer" },
          "results": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/HansardSearchResult" }
          }
        }
      },
      "HansardSearchResult": {
        "type": "object",
        "required": [
          "parliament_number",
          "session_number",
          "sitting_date",
          "intervention_id",
          "message_id",
          "speaker_name",
          "party_abbreviation",
          "riding_name",
          "topic",
          "snippet",
          "score"
        ],
        "properties": {
          "parliament_number": { "type": "integer" },
          "session_number": { "type": "integer" },
          "sitting_date": { "type": "string", "format": "date" },
          "intervention_id": { "type": "string" },
          "message_id": { "type": "string" },
          "speaker_name": { "type": "string" },
          "party_abbreviation": { "type": "string" },
          "riding_name": { "type": "string" },
          "topic": { "type": "string" },
          "snippet": { "type": "string", "description": "HTML snippet with <mark> tags around matches." },
          "score": { "type": "number", "format": "double" }
        }
      },
      "OnThisDayResponse": {
        "type": "object",
        "required": ["date", "items"],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/OnThisDayItem" }
          }
        }
      },
      "OnThisDayItem": {
        "type": "object",
        "required": ["id", "kind", "year", "date", "title", "excerpt"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string", "enum": ["speech", "vote"] },
          "year": { "type": "integer" },
          "date": { "type": "string", "format": "date" },
          "title": { "type": "string" },
          "excerpt": { "type": "string" },
          "speaker_name": { "type": "string" },
          "member_id": { "type": "string" },
          "subject_title": { "type": "string" },
          "intervention_id": { "type": "string" },
          "source_url": { "type": "string", "format": "uri" }
        }
      },
      "RidingBoundary": {
        "type": "object",
        "required": ["slug", "name", "external_id", "representation_order", "source", "source_url", "geometry"],
        "properties": {
          "slug": { "type": "string" },
          "name": { "type": "string" },
          "external_id": { "type": "string" },
          "representation_order": { "type": "string" },
          "source": { "type": "string" },
          "source_url": { "type": "string", "format": "uri" },
          "source_note": { "type": "string" },
          "extent": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 4,
            "maxItems": 4
          },
          "centroid": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          },
          "geometry": { "$ref": "#/components/schemas/GeoJSONGeometry" }
        }
      },
      "GeoJSONGeometry": {
        "type": "object",
        "required": ["type", "coordinates"],
        "properties": {
          "type": { "type": "string", "enum": ["Polygon", "MultiPolygon"] },
          "coordinates": {
            "type": "array",
            "description": "GeoJSON longitude/latitude coordinate arrays."
          }
        }
      },
      "BillsResponse": {
        "type": "object",
        "required": ["bills"],
        "properties": {
          "bills": { "type": "array", "items": { "$ref": "#/components/schemas/Bill" } }
        }
      },
      "Bill": {
        "type": "object",
        "required": ["id", "number", "title"],
        "properties": {
          "id": { "type": "string" },
          "number": { "type": "string" },
          "title": { "type": "string" },
          "current_stage": { "type": "string" },
          "introduced_on": { "type": "string", "format": "date" },
          "source_url": { "type": "string", "format": "uri" }
        }
      },
      "AppConfig": {
        "type": "object",
        "required": ["minimum_supported_version", "features"],
        "properties": {
          "minimum_supported_version": { "type": "string" },
          "features": {
            "type": "object",
            "additionalProperties": { "type": "boolean" }
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": ["status", "checked_at", "pipelines"],
        "properties": {
          "status": { "type": "string", "enum": ["ok", "degraded"] },
          "checked_at": { "type": "string", "format": "date-time" },
          "pipelines": { "type": "array", "items": { "$ref": "#/components/schemas/PipelineStatus" } }
        }
      },
      "PipelineStatus": {
        "type": "object",
        "required": ["name", "expected_interval_hours", "healthy"],
        "properties": {
          "name": { "type": "string" },
          "last_run_at": { "type": "string", "format": "date-time" },
          "last_success_at": { "type": "string", "format": "date-time" },
          "last_error": { "type": "string" },
          "record_count": { "type": "integer" },
          "expected_interval_hours": { "type": "integer" },
          "healthy": { "type": "boolean" },
          "stale_for": { "type": "string" }
        }
      },
      "EstimatesResponse": {
        "type": "object",
        "required": ["estimates"],
        "properties": {
          "estimates": { "type": "array", "items": { "$ref": "#/components/schemas/Estimate" } }
        }
      },
      "Estimate": {
        "type": "object",
        "required": ["fiscal_year", "organization_id", "organization_name", "vote_number", "vote_description", "authorities", "source"],
        "properties": {
          "fiscal_year": { "type": "string", "example": "2024-25" },
          "organization_id": { "type": "integer", "example": 1 },
          "organization_name": { "type": "string", "example": "Agriculture and Agri-Food Canada" },
          "vote_number": { "type": "integer", "example": 1 },
          "vote_description": { "type": "string", "example": "Operating expenditures" },
          "authorities": { "type": "number", "example": 1234567.89 },
          "source": { "type": "string", "example": "GC InfoBase" }
        }
      },
      "TelemetryRequest": {
        "type": "object",
        "required": ["device_id", "events"],
        "properties": {
          "device_id": { "type": "string", "maxLength": 64, "description": "UUID identifying the device." },
          "app_version": { "type": "string", "maxLength": 32 },
          "os_version": { "type": "string", "maxLength": 32 },
          "events": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/TelemetryEvent" },
            "minItems": 1,
            "maxItems": 100
          }
        }
      },
      "TelemetryEvent": {
        "type": "object",
        "required": ["type", "name", "ts"],
        "properties": {
          "type": { "type": "string", "enum": ["error", "event", "span"] },
          "name": { "type": "string", "maxLength": 128 },
          "operation": { "type": "string", "maxLength": 64 },
          "message": { "type": "string", "maxLength": 512 },
          "duration_ms": { "type": "integer", "minimum": 0, "maximum": 600000 },
          "attributes": {
            "type": "object",
            "additionalProperties": { "type": "string", "maxLength": 256 },
            "maxProperties": 16
          },
          "ts": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
