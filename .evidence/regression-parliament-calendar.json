{
  "_doc": "Regression evidence plan for Parliament-tab entry surfaces. Exercises the deep-link router into sitting overview, Hansard speech rendering, legacy share format, encoded-path routing, and home-fallback. Covers the read path through Fetch.downloadHansard/downloadCalendar, XMLBro.parseXML, HansardSpeakerParser, and ContentView.handleCustomScheme/handleUniversalLink. Out of scope: in-app calendar UI navigation, SpeechView replay/scroll, speaker-photo loading, EventKit export, Members/Accountability/Search/Home tabs. Requires the EPAC_EVIDENCE_MODE fixture-seed contract — see docs/regression/cyclomatic-complexity-coverage-map.md.",
  "repo": "RiddimSoftware/epac",
  "platform": "ios",
  "runner": "simctl",
  "ios": {
    "project": "ios/epac.xcodeproj",
    "scheme": "epac",
    "bundle_id": "net.dinglebox.cabinetdoor",
    "configuration": "Debug",
    "simulator": "iPhone 17 Pro Max",
    "simulator_udid": "1B4F22DF-E851-4A3B-AFFE-0EA338BD5D48",
    "destination": "platform=iOS Simulator,name=iPhone 17 Pro Max"
  },
  "launch": {
    "arguments": [
      "--evidence-mode",
      "-UIAnimationsDisabled",
      "YES"
    ],
    "environment": {
      "EPAC_EVIDENCE_MODE": "1",
      "EPAC_EVIDENCE_FIXTURE": "45-1-HAN050-E"
    }
  },
  "output_directory": "docs/build-evidence/regression-parliament-calendar",
  "video": { "enabled": false },
  "steps": [
    { "name": "launch app", "kind": "launch" },
    { "name": "settle after launch", "kind": "wait", "seconds": 2.0 },
    { "name": "baseline launch state", "kind": "screenshot", "path": "00-launch-baseline.png" },

    { "name": "open cs-sitting", "kind": "openURL", "url": "cabinetdoor://sitting/2025-11-04" },
    { "name": "settle cs-sitting", "kind": "wait", "seconds": 2.0 },
    { "name": "capture cs-sitting", "kind": "screenshot", "path": "cs-sitting.png" },

    { "name": "open cs-event", "kind": "openURL", "url": "cabinetdoor://event/2025-11-04" },
    { "name": "settle cs-event", "kind": "wait", "seconds": 2.0 },
    { "name": "capture cs-event", "kind": "screenshot", "path": "cs-event.png" },

    { "name": "open ul-sitting", "kind": "openURL", "url": "https://epac.riddimsoftware.com/sitting/2025-11-04" },
    { "name": "settle ul-sitting", "kind": "wait", "seconds": 2.0 },
    { "name": "capture ul-sitting", "kind": "screenshot", "path": "ul-sitting.png" },

    { "name": "open ul-speech", "kind": "openURL", "url": "https://epac.riddimsoftware.com/speech/13220089" },
    { "name": "settle ul-speech", "kind": "wait", "seconds": 2.0 },
    { "name": "capture ul-speech", "kind": "screenshot", "path": "ul-speech.png" },

    { "name": "open ul-app-legacy", "kind": "openURL", "url": "https://epac.riddimsoftware.com/app?date=2025-11-04&subjectID=1" },
    { "name": "settle ul-app-legacy", "kind": "wait", "seconds": 2.0 },
    { "name": "capture ul-app-legacy", "kind": "screenshot", "path": "ul-app-legacy.png" },

    { "name": "open ul-app-encoded-sitting", "kind": "openURL", "url": "https://epac.riddimsoftware.com/app?path=%2Fsitting%2F2025-11-04" },
    { "name": "settle ul-app-encoded-sitting", "kind": "wait", "seconds": 2.0 },
    { "name": "capture ul-app-encoded-sitting", "kind": "screenshot", "path": "ul-app-encoded-sitting.png" },

    { "name": "open cs-unrecognized", "kind": "openURL", "url": "cabinetdoor://nothing/123" },
    { "name": "settle cs-unrecognized", "kind": "wait", "seconds": 1.5 },
    { "name": "capture cs-unrecognized", "kind": "screenshot", "path": "cs-unrecognized.png" },

    { "name": "open ul-unknown-fallback", "kind": "openURL", "url": "https://epac.riddimsoftware.com/notarealroute" },
    { "name": "settle ul-unknown-fallback", "kind": "wait", "seconds": 1.5 },
    { "name": "capture ul-unknown-fallback", "kind": "screenshot", "path": "ul-unknown-fallback.png" }
  ]
}
