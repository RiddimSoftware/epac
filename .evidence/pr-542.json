  "pr": 542,
  "platform": "ios",
  "runner": "simctl",
  "ios": {
    "project": "ios/epac.xcodeproj",
    "scheme": "epac",
    "bundle_id": "net.dinglebox.cabinetdoor",
    "configuration": "Debug",
    "simulator": "iPhone 17 Pro Max",
