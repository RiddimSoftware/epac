default_platform(:ios)

platform :ios do
  desc "Build release archive and upload to TestFlight"
  lane :deploy do
    # Authenticate with App Store Connect API for the entire lane.
    api_key = app_store_connect_api_key(
      key_id:       ENV.fetch("ASC_KEY_ID"),
      issuer_id:    ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: File.expand_path(
        "~/.appstoreconnect/private_keys/AuthKey_#{ENV.fetch('ASC_KEY_ID')}.p8"
      ),
      duration:     1200,
      in_house:     false
    )

    # Bump build number ahead of the current TestFlight maximum.
    next_build_number = (latest_testflight_build_number(api_key: api_key) rescue 0) + 1
    increment_build_number(
      build_number: next_build_number,
      xcodeproj:    "epac.xcodeproj"
    )

    # ------------------------------------------------------------------
    # Provisioning profiles — one per bundle ID.
    #
    # sigh downloads the profile from App Store Connect via the API key.
    # It creates the profile if it does not exist yet (handles the App
    # Clip profile added in EPAC-75). The distribution certificate must
    # already be in the ephemeral keychain; the workflow imports it from
    # the DISTRIBUTION_CERT_P12 GitHub secret before calling this lane.
    # ------------------------------------------------------------------
    sigh(
      api_key:        api_key,
      app_identifier: "net.dinglebox.cabinetdoor",
      force:          false     # reuse the existing valid profile
    )

    sigh(
      api_key:        api_key,
      app_identifier: "net.dinglebox.cabinetdoor.Clip",
      force:          false
    )

    # ------------------------------------------------------------------
    # Archive and export.
    # The DEVELOPMENT_TEAM xcarg prevents Xcode from trying to discover
    # the team via the API, which would otherwise attempt to download or
    # create a certificate on ASC — filling the 2-cert limit.
    # ------------------------------------------------------------------
    build_app(
      scheme:           "epac",
      configuration:    "Release",
      export_method:    "app-store",
      xcargs:           "DEVELOPMENT_TEAM=ZG82TFXU3C",
      output_directory: "build",
      output_name:      "epac.ipa",
      clean:            true
    )

    upload_to_testflight(
      api_key:                           api_key,
      ipa:                               "build/epac.ipa",
      skip_waiting_for_build_processing: true,
      distribute_external:               false,
      notify_external_testers:           false
    )
  end
end
