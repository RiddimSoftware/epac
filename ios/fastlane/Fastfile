default_platform(:ios)

platform :ios do
  desc "Build release archive and upload to TestFlight"
  lane :deploy do
    # Authenticate with App Store Connect API for the entire lane.
    api_key = app_store_connect_api_key(
      key_id:       ENV.fetch("ASC_KEY_ID"),
      issuer_id:    ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: File.expand_path(
        "~/.appstoreconnect/private_keys/AuthKey_#{ENV.fetch('ASC_KEY_ID')}.p8"
      ),
      duration:     1200,
      in_house:     false
    )

    # Bump build number ahead of the current TestFlight maximum.
    next_build_number = (latest_testflight_build_number(api_key: api_key) rescue 0) + 1
    increment_build_number(
      build_number: next_build_number,
      xcodeproj:    "epac.xcodeproj"
    )

    # ------------------------------------------------------------------
    # Provisioning profiles via sigh.
    #
    # The distribution certificate was pre-installed into the ephemeral
    # keychain by the workflow's "Import distribution certificate" step.
    # sigh uses that certificate to create or download profiles from ASC,
    # installing them into ~/Library/MobileDevice/Provisioning Profiles/.
    # ------------------------------------------------------------------
    sigh(
      api_key:        api_key,
      app_identifier: "net.dinglebox.cabinetdoor",
      force:          false
    )

    sigh(
      api_key:        api_key,
      app_identifier: "net.dinglebox.cabinetdoor.Clip",
      force:          false
    )

    # ------------------------------------------------------------------
    # Archive and export.
    #
    # The Xcode project uses CODE_SIGN_STYLE=Manual in the pbxproj, so
    # xcodebuild requires -allowProvisioningUpdates to switch signing to
    # Automatic mode and pick up the profiles sigh just downloaded.
    #
    # Previously -allowProvisioningUpdates caused xcodebuild to CREATE a
    # new distribution certificate (hitting Apple's 2-cert limit). That
    # is now safe because the workflow pre-imports the cert from the
    # DISTRIBUTION_CERT_P12 secret — xcodebuild finds it in the keychain
    # and reuses it instead of creating a new one.
    # ------------------------------------------------------------------
    key_path = File.expand_path(
      "~/.appstoreconnect/private_keys/AuthKey_#{ENV.fetch('ASC_KEY_ID')}.p8"
    )
    build_app(
      scheme:           "epac",
      configuration:    "Release",
      export_method:    "app-store",
      xcargs:           [
        "-allowProvisioningUpdates",
        "-authenticationKeyPath #{key_path}",
        "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')}",
        "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}",
        "DEVELOPMENT_TEAM=ZG82TFXU3C"
      ].join(" "),
      output_directory: "build",
      output_name:      "epac.ipa",
      clean:            true
    )

    upload_to_testflight(
      api_key:                           api_key,
      ipa:                               "build/epac.ipa",
      skip_waiting_for_build_processing: true,
      distribute_external:               false,
      notify_external_testers:           false
    )
  end
end
