default_platform(:ios)

platform :ios do
  desc "Upload App Store metadata (no binary, no review submission)"
  lane :deliver do
    api_key = app_store_connect_api_key(
      key_id:       ENV.fetch("ASC_KEY_ID"),
      issuer_id:    ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: File.expand_path(
        "~/.appstoreconnect/private_keys/AuthKey_#{ENV.fetch('ASC_KEY_ID')}.p8"
      ),
      duration:     1200,
      in_house:     false
    )

    require 'spaceship'
    app = Spaceship::ConnectAPI::App.find("net.dinglebox.cabinetdoor")
    version = app.get_edit_app_store_version
    unless version
      UI.user_error!("No editable App Store version found. Create it manually in ASC first.")
    end

    supported_locales = version.get_app_store_version_localizations.map(&:locale)
    Dir.glob("./fastlane/metadata/*").each do |dir|
      next unless File.directory?(dir)
      locale = File.basename(dir)
      unless supported_locales.include?(locale)
        UI.user_error!(
          "Localization '#{locale}' found in repo but NOT in App Store Connect.\n\n" \
          "DO NOT let fastlane auto-create it — Apple's create-localization endpoint runs a\n" \
          "global app-name uniqueness check and will reject with 'Cannot add localization due\n" \
          "to app name' (see docs/development/release-pipeline-gaps.md Gap 3).\n\n" \
          "Operator steps:\n" \
          "  1. Open https://appstoreconnect.apple.com → My Apps → ePac → App Store tab\n" \
          "  2. Under the editable version, click '+' next to localizations and add '#{locale}'\n" \
          "  3. Re-run: bundle exec fastlane deliver\n"
        )
      end
    end

    upload_to_app_store(
      api_key:              api_key,
      skip_binary_upload:   true,
      submit_for_review:    false,
      force:                true,
      metadata_path:        "./fastlane/metadata",
      screenshots_path:     "./fastlane/screenshots",
      skip_screenshots:     false
    )
    end

  desc "Build release archive and upload to TestFlight"
  lane :deploy do
    # Authenticate with App Store Connect API for the entire lane.
    api_key = app_store_connect_api_key(
      key_id:       ENV.fetch("ASC_KEY_ID"),
      issuer_id:    ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: File.expand_path(
        "~/.appstoreconnect/private_keys/AuthKey_#{ENV.fetch('ASC_KEY_ID')}.p8"
      ),
      duration:     1200,
      in_house:     false
    )

    # Set marketing version when provided by the release workflow.
    new_version = ENV.fetch("NEW_VERSION", "")
    unless new_version.empty?
      increment_version_number(
        version_number: new_version,
        xcodeproj:      "epac.xcodeproj"
      )
    end

    # Bump build number ahead of the current TestFlight maximum.
    next_build_number = (latest_testflight_build_number(api_key: api_key) rescue 0) + 1
    increment_build_number(
      build_number: next_build_number,
      xcodeproj:    "epac.xcodeproj"
    )
    if (gh_output = ENV["GITHUB_OUTPUT"])

      File.write(gh_output, "build_number=#{next_build_number}\n")
    else

      File.write("build_number.txt", next_build_number.to_s)
    end


    # ------------------------------------------------------------------
    # 1. Download / create provisioning profiles via sigh.
    #
    # sigh uses the cert already in the keychain (imported from the
    # DISTRIBUTION_CERT_P12 secret) to find or create App Store profiles.
    # It returns the profile UUID, which we pass to xcodebuild explicitly.
    # ------------------------------------------------------------------
    main_uuid = sigh(
      api_key:        api_key,
      app_identifier: "net.dinglebox.cabinetdoor",
      force:          false
    )

    clip_uuid = sigh(
      api_key:        api_key,
      app_identifier: "net.dinglebox.cabinetdoor.Clip",
      force:          false
    )

    # ------------------------------------------------------------------
    # 2. Bake the profile UUIDs into the Xcode project.
    #
    # This lets xcodebuild use Manual signing with the exact profiles
    # sigh just installed. xcodebuild never calls the ASC API during the
    # build, so it never tries to create a new certificate — eliminating
    # the 2-cert account limit problem entirely.
    # ------------------------------------------------------------------
    update_code_signing_settings(
      use_automatic_signing: false,
      path:                  "epac.xcodeproj",
      team_id:               ENV["APPLE_TEAM_ID"],
      targets:               ["epac"],
      code_sign_identity:    "Apple Distribution",
      profile_uuid:          main_uuid
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path:                  "epac.xcodeproj",
      team_id:               ENV["APPLE_TEAM_ID"],
      targets:               ["epac-clip"],
      code_sign_identity:    "Apple Distribution",
      profile_uuid:          clip_uuid
    )

    # ------------------------------------------------------------------
    # 3. Archive and export — no ASC API calls during the build.
    # ------------------------------------------------------------------
    sentry_dsn = ENV.fetch("SENTRY_DSN", "")
    backend_base_url = ENV.fetch("BACKEND_BASE_URL", "")
    extra_xcargs = "DEVELOPMENT_TEAM=#{ENV["APPLE_TEAM_ID"]} SENTRY_DSN=#{sentry_dsn}"
    unless new_version.empty?
      extra_xcargs += " MARKETING_VERSION=#{new_version}"
    end
    unless backend_base_url.empty?
      extra_xcargs += " BACKEND_BASE_URL=#{backend_base_url}"
    end
    build_app(
      scheme:           "epac",
      configuration:    "Release",
      export_method:    "app-store",
      xcargs:           extra_xcargs,
      cloned_source_packages_path: ENV["SPM_CLONED_SOURCE_PACKAGES_PATH"],
      output_directory: "build",
      output_name:      "epac.ipa",
      clean:            false
    )

    skip_waiting_for_build_processing =
      ENV.fetch("SKIP_WAITING_FOR_BUILD_PROCESSING", "true") != "false"
    testflight_options = {
      api_key:                           api_key,
      ipa:                               "build/epac.ipa",
      skip_waiting_for_build_processing: skip_waiting_for_build_processing,
      distribute_external:               false,
      notify_external_testers:           false
    }
    testflight_changelog = ENV.fetch("TESTFLIGHT_CHANGELOG", "")
    unless testflight_changelog.empty?
      testflight_options[:changelog] = testflight_changelog
    end
    upload_to_testflight(**testflight_options)
    end
end
