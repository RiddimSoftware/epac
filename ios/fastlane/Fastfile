default_platform(:ios)

platform :ios do
  desc "Build release archive and upload to TestFlight"
  lane :deploy do
    # Authenticate with App Store Connect API for the entire lane.
    api_key = app_store_connect_api_key(
      key_id:       ENV.fetch("ASC_KEY_ID"),
      issuer_id:    ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: File.expand_path(
        "~/.appstoreconnect/private_keys/AuthKey_#{ENV.fetch('ASC_KEY_ID')}.p8"
      ),
      duration:     1200,
      in_house:     false
    )

    # Bump build number ahead of the current TestFlight maximum.
    next_build_number = (latest_testflight_build_number(api_key: api_key) rescue 0) + 1
    increment_build_number(
      build_number: next_build_number,
      xcodeproj:    "epac.xcodeproj"
    )

    # ------------------------------------------------------------------
    # Provisioning profiles.
    #
    # sigh requires the distribution certificate to already be installed
    # in the keychain. The workflow imports it from the
    # DISTRIBUTION_CERT_P12 GitHub secret (see .github/workflows/build-
    # deploy.yml for setup instructions). Until that secret is added,
    # skip sigh and let build_app use -allowProvisioningUpdates instead.
    #
    # Once DISTRIBUTION_CERT_P12 is set, uncomment these two blocks:
    #
    # sigh(
    #   api_key:        api_key,
    #   app_identifier: "net.dinglebox.cabinetdoor",
    #   force:          false
    # )
    # sigh(
    #   api_key:        api_key,
    #   app_identifier: "net.dinglebox.cabinetdoor.Clip",
    #   force:          false
    # )
    # ------------------------------------------------------------------

    # ------------------------------------------------------------------
    # Archive and export.
    #
    # -allowProvisioningUpdates lets Xcode download and create profiles
    # via the ASC API key. It will also CREATE a new distribution cert
    # if none is found in the keychain — this hits Apple's 2-cert limit.
    # Adding DISTRIBUTION_CERT_P12 to GitHub secrets pre-installs the
    # cert and eliminates that problem.
    # ------------------------------------------------------------------
    key_path = File.expand_path(
      "~/.appstoreconnect/private_keys/AuthKey_#{ENV.fetch('ASC_KEY_ID')}.p8"
    )
    build_app(
      scheme:           "epac",
      configuration:    "Release",
      export_method:    "app-store",
      xcargs:           [
        "-allowProvisioningUpdates",
        "-authenticationKeyPath #{key_path}",
        "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')}",
        "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}",
        "DEVELOPMENT_TEAM=ZG82TFXU3C"
      ].join(" "),
      output_directory: "build",
      output_name:      "epac.ipa",
      clean:            true
    )

    upload_to_testflight(
      api_key:                           api_key,
      ipa:                               "build/epac.ipa",
      skip_waiting_for_build_processing: true,
      distribute_external:               false,
      notify_external_testers:           false
    )
  end
end
