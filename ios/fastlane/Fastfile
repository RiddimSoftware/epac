default_platform(:ios)

platform :ios do
  desc "Build release archive and upload to TestFlight"
  lane :deploy do
    # Authenticate with App Store Connect API for the entire lane.
    api_key = app_store_connect_api_key(
      key_id:       ENV.fetch("ASC_KEY_ID"),
      issuer_id:    ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: File.expand_path(
        "~/.appstoreconnect/private_keys/AuthKey_#{ENV.fetch('ASC_KEY_ID')}.p8"
      ),
      duration:     1200,
      in_house:     false
    )

    # Bump build number ahead of the current TestFlight maximum.
    next_build_number = (latest_testflight_build_number(api_key: api_key) rescue 0) + 1
    increment_build_number(
      build_number: next_build_number,
      xcodeproj:    "epac.xcodeproj"
    )

    # ------------------------------------------------------------------
    # Provisioning profiles via sigh.
    #
    # The distribution certificate was pre-installed into the ephemeral
    # keychain by the "Import distribution certificate" workflow step
    # (from the DISTRIBUTION_CERT_P12 secret). sigh uses the cert already
    # in the keychain to create or download matching profiles — it does
    # NOT create a new certificate, so the 2-cert account limit is safe.
    #
    # The App Clip profile (net.dinglebox.cabinetdoor.Clip) didn't exist
    # until this lane creates it. sigh creates it automatically on first
    # run, then reuses it on subsequent runs.
    # ------------------------------------------------------------------
    sigh(
      api_key:        api_key,
      app_identifier: "net.dinglebox.cabinetdoor",
      force:          false
    )

    sigh(
      api_key:        api_key,
      app_identifier: "net.dinglebox.cabinetdoor.Clip",
      force:          false
    )

    # ------------------------------------------------------------------
    # Archive and export.
    #
    # No -allowProvisioningUpdates: the cert and profiles are already
    # installed by the steps above. Passing -allowProvisioningUpdates
    # alongside a keychain that has an imported cert still causes Xcode
    # to call the ASC API to "verify" the certificate, which triggers a
    # new-cert creation attempt and hits the 2-cert limit.
    # ------------------------------------------------------------------
    build_app(
      scheme:           "epac",
      configuration:    "Release",
      export_method:    "app-store",
      xcargs:           "DEVELOPMENT_TEAM=ZG82TFXU3C CODE_SIGN_STYLE=Automatic",
      output_directory: "build",
      output_name:      "epac.ipa",
      clean:            true
    )

    upload_to_testflight(
      api_key:                           api_key,
      ipa:                               "build/epac.ipa",
      skip_waiting_for_build_processing: true,
      distribute_external:               false,
      notify_external_testers:           false
    )
  end
end
