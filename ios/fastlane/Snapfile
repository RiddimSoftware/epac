# Devices to capture (required App Store sizes)
devices([
  "iPhone 16 Pro Max",   # 6.9" — required
  "iPhone 16",           # 6.1" — required for older devices
])

languages(["en-CA"])

# Scheme must have UI test target
scheme("epac")

# Output directory
output_directory("./fastlane/screenshots")
output_files("png")

# Clear existing screenshots before new run
clear_previous_screenshots(true)

# Stop on first failure
stop_after_first_error(true)
