{
  "Comment": "Lobbying-index staging pipeline. backend-staging.yml renders the Lambda ARN into each Task. The Lambda writes intermediates under <LOBBYING_INDEX_PREFIX>/tmp/<payload phase>.sqlite and publishes index.sqlite plus manifest.json.",
  "StartAt": "IngestOCLData",
  "States": {
    "IngestOCLData": {
      "Type": "Task",
      "Comment": "Download OCL CSVs, parse them, write raw tables, and upload tmp/IngestOCLData.sqlite.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "TimeoutSeconds": 900,
      "Parameters": {
        "FunctionName": "${LobbyingIndexLambdaArn}",
        "Payload": {
          "phase": "IngestOCLData"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "IngestOCLDataFailed"
        }
      ],
      "Next": "AggregateMPLobbying"
    },
    "AggregateMPLobbying": {
      "Type": "Task",
      "Comment": "Run MP lobbying SQL aggregations. Lambda phase BuildMPLobbying consumes tmp/IngestOCLData.sqlite and writes tmp/BuildMPLobbying.sqlite.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "TimeoutSeconds": 900,
      "Parameters": {
        "FunctionName": "${LobbyingIndexLambdaArn}",
        "Payload": {
          "phase": "BuildMPLobbying"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "AggregateMPLobbyingFailed"
        }
      ],
      "Next": "BuildOrganizationTables"
    },
    "BuildOrganizationTables": {
      "Type": "Task",
      "Comment": "Build organization profile tables from tmp/BuildMPLobbying.sqlite and write tmp/BuildOrganizationTables.sqlite.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "TimeoutSeconds": 900,
      "Parameters": {
        "FunctionName": "${LobbyingIndexLambdaArn}",
        "Payload": {
          "phase": "BuildOrganizationTables"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "BuildOrganizationTablesFailed"
        }
      ],
      "Next": "BuildBillContextTables"
    },
    "BuildBillContextTables": {
      "Type": "Task",
      "Comment": "Fetch LEGISinfo bill metadata, consume tmp/BuildOrganizationTables.sqlite, and write tmp/BuildBillContextTables.sqlite.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "TimeoutSeconds": 900,
      "Parameters": {
        "FunctionName": "${LobbyingIndexLambdaArn}",
        "Payload": {
          "phase": "BuildBillContextTables"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "BuildBillContextTablesFailed"
        }
      ],
      "Next": "PreBakeMinisterCommunications"
    },
    "PreBakeMinisterCommunications": {
      "Type": "Task",
      "Comment": "Pre-bake minister portfolio tables from tmp/BuildBillContextTables.sqlite and write tmp/PreBakeMinisterCommunications.sqlite.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "TimeoutSeconds": 900,
      "Parameters": {
        "FunctionName": "${LobbyingIndexLambdaArn}",
        "Payload": {
          "phase": "PreBakeMinisterCommunications"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "PreBakeMinisterCommunicationsFailed"
        }
      ],
      "Next": "UploadArtifact"
    },
    "UploadArtifact": {
      "Type": "Task",
      "Comment": "Upload the final SQLite artifact and manifest. Lambda phase Finalize consumes tmp/PreBakeMinisterCommunications.sqlite.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "TimeoutSeconds": 900,
      "Parameters": {
        "FunctionName": "${LobbyingIndexLambdaArn}",
        "Payload": {
          "phase": "Finalize"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "UploadArtifactFailed"
        }
      ],
      "End": true
    },
    "IngestOCLDataFailed": {
      "Type": "Fail",
      "Error": "LobbyingIndexPhaseFailed",
      "Cause": "IngestOCLData failed."
    },
    "AggregateMPLobbyingFailed": {
      "Type": "Fail",
      "Error": "LobbyingIndexPhaseFailed",
      "Cause": "AggregateMPLobbying failed. Lambda payload phase: BuildMPLobbying."
    },
    "BuildOrganizationTablesFailed": {
      "Type": "Fail",
      "Error": "LobbyingIndexPhaseFailed",
      "Cause": "BuildOrganizationTables failed."
    },
    "BuildBillContextTablesFailed": {
      "Type": "Fail",
      "Error": "LobbyingIndexPhaseFailed",
      "Cause": "BuildBillContextTables failed."
    },
    "PreBakeMinisterCommunicationsFailed": {
      "Type": "Fail",
      "Error": "LobbyingIndexPhaseFailed",
      "Cause": "PreBakeMinisterCommunications failed."
    },
    "UploadArtifactFailed": {
      "Type": "Fail",
      "Error": "LobbyingIndexPhaseFailed",
      "Cause": "UploadArtifact failed. Lambda payload phase: Finalize."
    }
  }
}
