      {
        "hooks" : [
          {
            "command" : "bash -c 'python3 \"$(dirname \"$(git rev-parse --git-common-dir)\")\/scripts\/intake\/intake_session_hook.py\" post-tool-use'",
            "type" : "command"
          }
        ],
        "matcher" : "*"
      }
    ],
    "SessionStart" : [
      {
        "hooks" : [
          {
            "command" : "bash -c 'python3 \"$(dirname \"$(git rev-parse --git-common-dir)\")\/scripts\/intake\/intake_session_hook.py\" session-start'",
