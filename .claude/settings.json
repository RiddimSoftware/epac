      }
    ],
    "UserPromptSubmit" : [
      {
        "hooks" : [
          {
            "command" : "python3 scripts\/intake\/intake_session_hook.py user-prompt-submit",
            "type" : "command"
          }
        ]
      }
    ]
  }
