{
  "disabledMcpjsonServers" : [

  ],
  "hooks" : {
    "PostToolUse" : [
      {
        "hooks" : [
          {
            "command" : "python3 scripts\/intake\/intake_session_hook.py post-tool-use",
            "type" : "command"
          }
        ],
        "matcher" : "*"
      }
    ],
    "SessionStart" : [
      {
        "hooks" : [
          {
            "command" : "python3 scripts\/intake\/intake_session_hook.py session-start",
