          }
        ]
      }
    ],
    "Stop" : [
      {
        "hooks" : [
          {
            "command" : "bash -c 'python3 \"$(dirname \"$(git rev-parse --git-common-dir)\")\/scripts\/intake\/intake_session_hook.py\" stop'",
            "type" : "command"
          }
        ]
      }
    ],
    "UserPromptSubmit" : [
      {
        "hooks" : [
          {
            "command" : "bash -c 'python3 \"$(dirname \"$(git rev-parse --git-common-dir)\")\/scripts\/intake\/intake_session_hook.py\" user-prompt-submit'",
